# Shared command-line tools
brew "chezmoi"
brew "git"
brew "emacs"
brew "python"
brew "jq"

# OpenAI Codex CLI
cask "codex"

# Password-store secrets used by chezmoi templates
brew "pass"
brew "gnupg"

# Web browser
cask "brave-browser"

# Nextcloud file sync
cask "nextcloud"

# Gaming
cask "steam"

# 3D printing
cask "orcaslicer"

# CAD
cask "freecad"
cask "autodesk-fusion"

# Logitech mouse configuration
cask "logi-options+"

# Audio interface control on the Mac Studio only
require "socket"
cask "focusrite-control-2" if Socket.gethostname.split(".").first == "mac-studio-m5"

# Terminals and font used by the shared Alacritty configuration
cask "alacritty"
cask "ghostty"
cask "font-inconsolata"

# Focus and raise windows when hovering
tap "dimentium/autoraise"
brew "dimentium/autoraise/autoraise"

