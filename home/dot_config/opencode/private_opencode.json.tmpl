{
  "disabled_providers": [
    "opencode",
    "openai",
    "nvidia",
    "openrouter"
  ],
  "$schema": "https://opencode.ai/config.json",
  "share": "disabled",
  "providers": {
    "AquaAI": {
      "name": "AquaAI",
      "package": "@opencode/ai/providers/openai-compatible",
      "settings": {
        "apiKey": {{ pass "self-host/token/litellm-opencode" | toJson }},
        "baseURL": "https://litellm.aquamorph.com/v1"
      },
      "models": {
        "gpt-6.1-sol": {
          "name": "GPT-6.1 Sol",
          "modelID": "chatgpt/gpt-6.1-sol"
        },
        "gpt-6-luna": {
          "name": "GPT-6 Luna",
          "modelID": "chatgpt/gpt-6-luna"
        },
        "aquaai/gemma4:12b": {
          "name": "aquaai/gemma4:12b"
        },
        "mistralai/mistral-large-4-1t-a52b": {
          "name": "mistralai/mistral-large-4-1t-a52b"
        },
        "moonshotai/kimi-k3_1-pro": {
          "name": "moonshotai/kimi-k3_1-pro"
        },
        "nvidia/nemotron-3.5-lightning-30b-a3b": {
          "name": "nvidia/nemotron-3.5-lightning-30b-a3b"
        },
        "nvidia/nemotron-3.5-super-vl-120b-a12b": {
          "name": "nvidia/nemotron-3.5-super-vl-120b-a12b"
        }
      }
    }
  }
}
