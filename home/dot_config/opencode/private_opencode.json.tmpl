{
  "disabled_providers": [
    "opencode",
    "openai",
    "nvidia",
    "openrouter"
  ],
  "$schema": "https://opencode.ai/config.json",
  "share": "disabled",
  "plugins": [
    {
      "package": "./plugins/aquaai-models",
      "options": {
        "provider": "AquaAI",
        "refreshIntervalMs": 300000
      }
    }
  ],
  "providers": {
    "AquaAI": {
      "name": "AquaAI",
      "package": "@opencode/ai/providers/openai-compatible",
      "settings": {
        "apiKey": {{ if env "OPENCODE_API_KEY_FILE" }}{{ printf "{file:%s}" (env "OPENCODE_API_KEY_FILE") | toJson }}{{ else }}{{ pass "self-host/token/litellm-opencode" | toJson }}{{ end }},
        "baseURL": "https://litellm.aquamorph.com/v1"
      }
    }
  }
}
