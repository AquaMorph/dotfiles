{
  "disabled_providers": [
    "opencode",
    "openai"
  ],
  "$schema": "https://opencode.ai/config.json",
  "share": "disabled",
  "providers": {
    "AquaAI": {
      "name": "AquaAI",
      "package": "@opencode/ai/providers/openai-compatible",
      "settings": {
        "apiKey": {{ pass "self-host/token/litellm-opencode" | toJson }},
        "baseURL": "https://litellm.aquamorph.com/v1"
      },
      "models": {
        "gpt-6.1-sol": {
          "name": "GPT-6.1 Sol",
          "modelID": "chatgpt/gpt-6.1-sol"
        },
        "gpt-6-luna": {
          "name": "GPT-6 Luna",
          "modelID": "chatgpt/gpt-6-luna"
        },
        "aquaai/gemma4:12b": {
          "name": "aquaai/gemma4:12b"
        }
      }
    }
  }
}
