# Focus and raise on hover without an intentional delay; never warp the cursor.
pollMillis=50
delay=1
requireMouseStop=true
warpX=0
warpY=0
# Hold Control to temporarily suspend hover focus.
disableKey=control
# Do not steal focus during authentication or screenshot selection.
stayFocusedBundleIds="com.apple.SecurityAgent,com.apple.screencaptureui"
