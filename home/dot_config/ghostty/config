# Match the shared Alacritty appearance.
font-family = Inconsolata
font-size = 16

# Support Control and Command across keyboard-specific macOS remappings.
keybind = ctrl+==increase_font_size:1
keybind = ctrl++=increase_font_size:1
keybind = ctrl+shift+==increase_font_size:1
keybind = ctrl+-=decrease_font_size:1
keybind = super+==increase_font_size:1
keybind = super++=increase_font_size:1
keybind = super+shift+==increase_font_size:1
keybind = super+-=decrease_font_size:1

keybind = ctrl+shift+v=paste_from_clipboard
keybind = super+shift+v=paste_from_clipboard

background = #000000
foreground = #0288d1
background-opacity = 0.8
bold-is-bright = true

palette = 0=#000000
palette = 1=#d54e53
palette = 2=#b9ca4a
palette = 3=#e6c547
palette = 4=#7aa6da
palette = 5=#c397d8
palette = 6=#70c0ba
palette = 7=#eaeaea
palette = 8=#666666
palette = 9=#ff3334
palette = 10=#9ec400
palette = 11=#e7c547
palette = 12=#7aa6da
palette = 13=#b77ee0
palette = 14=#54ced6
palette = 15=#ffffff

cursor-style = block
cursor-style-blink = false
mouse-hide-while-typing = false
copy-on-select = false

window-padding-x = 4
window-padding-y = 4
