[user]
	name = Christian Colglazier
	email = christian@cacolglazier.com
[core]
	editor = emacs -nw
	excludesFile = ~/.gitignore
[rerere]
	enabled = true
[column]
	ui = auto
[branch]
	sort = -committerdate
[push]
	autoSetupRemote = true
[filter "lfs"]
	required = true
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
